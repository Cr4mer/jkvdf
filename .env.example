# Copy this file to .env.local and fill in the values, then run `npm run dev`.
# .env.local is gitignored. These VITE_* vars are bundled into the client at
# build time (Firebase web config is not secret, but keep it out of git anyway).
#
# Find the Firebase web config in the Firebase console:
#   Project settings -> General -> Your apps -> SDK setup and configuration
# Project: jkvdf-d185b

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=jkvdf-d185b.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=jkvdf-d185b
VITE_FIREBASE_STORAGE_BUCKET=jkvdf-d185b.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: FACEIT Data API key for client-side FACEIT lookups (src/utils/faceitApi.ts).
# Get one at https://developers.faceit.com/
VITE_FACEIT_API_KEY=
