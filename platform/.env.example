# Supabase project (Postgres + Auth + RLS)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # server-side only, never shipped to the browser

# Lemon Squeezy (merchant of record: handles VAT, invoices, card retries)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=          # "signing secret" on the webhook you create in the dashboard
LEMONSQUEEZY_VARIANT_TEAM_MONTHLY=    # variant id of "Team, EUR 9.99 / month"
LEMONSQUEEZY_VARIANT_TEAM_YEARLY=     # variant id of "Team, EUR 89 / year"

APP_URL=https://app.example.com       # used for the post-checkout redirect
